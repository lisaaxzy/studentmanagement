<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Management</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="site-header">
    <nav class="nav">
      <span class="brand">Student Management System</span>
      <div class="nav-links">
        <a href="/">Students</a>
        <a href="/students/add">Add Student</a>
      </div>
    </nav>
  </header>

  <main class="container">
    <h1>Student List</h1>

    <div class="toolbar">
      <form class="search-form" action="/students/search" method="GET">
        <input type="text" name="keyword" placeholder="Search by ID, name, or course">
        <button class="btn" type="submit">Search</button>
      </form>
      <a class="btn" href="/students/add">+ Add Student</a>
    </div>

    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Student ID</th>
              <th>Name</th>
              <th>Course</th>
              <th>Year</th>
              <th>Email</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (students.length === 0) { %>
              <tr><td colspan="7" class="empty">No students found.</td></tr>
            <% } else { %>
              <% students.forEach(student => { %>
                <tr>
                  <td><%= student.id %></td>
                  <td><%= student.student_id %></td>
                  <td><%= student.first_name %> <%= student.last_name %></td>
                  <td><%= student.course %></td>
                  <td><%= student.year_level %></td>
                  <td><%= student.email %></td>
                  <td>
                    <form action="/students/delete/<%= student.id %>" method="POST"
                            onsubmit="return confirm('Delete this student?');">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                    </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>